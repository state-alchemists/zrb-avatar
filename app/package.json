{
  "name": "zrb-avatar",
  "version": "0.1.2",
  "description": "zrb's avatar as an always-on-top desktop window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . zrb-avatar --platform=win32 --arch=x64 --out=dist --overwrite",
    "pack:mac": "electron-packager . zrb-avatar --platform=darwin --arch=arm64,x64 --out=dist --overwrite",
    "pack:linux": "electron-packager . zrb-avatar --platform=linux --arch=x64 --out=dist --overwrite"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.2.1",
    "three": "0.169.0"
  }
}
